{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/sw.js", "/manifest.webmanifest", "/robots.txt", "/sitemap.xml"]
  },
  "globalHeaders": {
    "Cache-Control": "no-cache, max-age=0, must-revalidate",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' blob: data:; style-src 'self'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
  },
  "routes": [
    {
      "route": "/",
      "rewrite": "/index.html"
    },
    {
      "route": "/index.html",
      "rewrite": "/index.html"
    },
    {
      "route": "/demo",
      "rewrite": "/index.html"
    },
    {
      "route": "/privacy",
      "rewrite": "/privacy/index.html"
    },
    {
      "route": "/terms",
      "rewrite": "/terms/index.html"
    },
    {
      "route": "/404",
      "rewrite": "/404.html",
      "statusCode": 404
    },
    {
      "route": "/assets/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/sw.js",
      "headers": {
        "Cache-Control": "no-cache, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/manifest.webmanifest"
    },
    {
      "route": "/robots.txt"
    },
    {
      "route": "/sitemap.xml"
    },
    {
      "route": "/404.css"
    },
    {
      "route": "/404.html"
    },
    {
      "route": "/site-page.css"
    },
    {
      "route": "/LICENSE.txt"
    },
    {
      "route": "/*",
      "rewrite": "/404.html",
      "statusCode": 404
    }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json"
  }
}
