{
  "name": "floorplan-text-dsl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "test:all": "npm test && npm run build && npm run test:browser",
    "test:keyboard": "playwright test --grep @keyboard",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.3.0",
    "playwright": "1.58.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
